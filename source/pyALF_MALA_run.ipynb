   "source": [
    "**3.** Define the simulation, overwriting the default parameters to reproduce the `Hubbard` / `N_leg_ladder` / MALA setup from `parameters`:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "30b246fe",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Parameters shared by every simulation in the sweep\n",
    "base_params = {\n",
    "    \"Lattice_type\": \"N_leg_ladder\",\n",
    "    \"L1\": 1,\n",
    "    \"L2\": 6,\n",
    "    \"Model\": \"Hubbard\",\n",
    "    \"Checkerboard\": True,\n",
    "    \"Symm\": True,\n",
    "    \"N_SUN\": 2,\n",
    "    \"N_FL\": 1,\n",
    "    \"Dtau\": 0.1,\n",
    "    \"Beta\": 4.0,\n",
    "    \"Projector\": False,\n",
    "    \"Theta\": 10.0,\n",
    "    \"Nwrap\": 10,\n",
    "    \"NSweep\": 500,\n",
    "    \"NBin\": 5,\n",
    "    \"Ltau\": 0,\n",
    "    \"Mz\": True,\n",
    "    \"ham_T\": 1.0,\n",
    "    \"ham_chem\": 0.0,\n",
    "    \"ham_U\": 4.0,\n",
    "    \"Propose_S0\": False,\n",
    "    \"Amplitude\": 0.5,\n",
    "    \"Delta_t_MALA_sequential\": 0.5,\n",
    "    \"Max_Force_MALA_sequential\": 5.0,\n",
    "    \"Global_tau_moves\": False,\n",
    "    \"N_global_tau\": 1,\n",
    "    \"N_global_tau_MALA\": 1,\n",
    "    \"Delta_t_MALA_global_tau\": 0.5,\n",
    "    \"Max_Force_MALA_global_tau\": 5.0,\n",
    "    \"Delta_t_MALA_global\": 0.5,\n",
    "    \"Max_Force_MALA_global\": 5.0,\n",
    "    \"CPU_MAX\":0.05,\n",
    "}\n",
    "\n",
    "# Each entry below overrides base_params for one run. Add, remove, or edit\n",
    "# entries here to sweep over any variable(s), e.g. Continuous, Propose_MALA,\n",
    "# or Delta_t_MALA_sequential.\n",
    "variants = {\n",
    "     \"Run_2.2.1\":   {\"desc\": \"Sequential update, discrete field\",\n",
    "                      \"Sequential\": True,\"Continuous\": False, \"Sequential_MALA\": False},\n",
    "     \"Run_2.2.2.1\": {\"desc\": \"Sequential update, continuous field, no MALA\",\n",
    "                      \"Sequential\": True,\"Continuous\": True,  \"Sequential_MALA\": False},\n",
    "     \"Run_2.2.2.2\": {\"desc\": \"Sequential update, continuous field, with MALA\",\n",
    "                     \"Sequential\": True,\"Continuous\": True,  \"Sequential_MALA\": True},\n",
    "     \"Run_2.2.3.1\": {\"desc\": \"Sequential + global tau moves, continuous field, no MALA\",\n",
    "                      \"Sequential\": True, \"Global_tau_moves\": True, \"Continuous\": True,  \"Sequential_MALA\": False},\n",
    "     \"Run_2.2.3.2\": {\"desc\": \"Sequential + global tau moves, continuous field, with MALA\",\n",
    "                      \"Sequential\": True, \"Global_tau_moves\": True, \"Continuous\": True,  \"Sequential_MALA\": True},\n",
    "     \"Run_2.3.1.1\": {\"desc\": \"Sequential MALA + global moves (N_Global=10)\",\n",
    "                     \"Sequential\": True, \"Continuous\": True,  \"Sequential_MALA\": True,\n",
    "                     \"Global_moves\": True, \"N_Global\": 10},\n",
    "     \"Run_2.3.1.2\": {\"desc\": \"Sequential MALA + global MALA moves (N_Global_MALA_sweeps=10)\",\n",
    "                     \"Sequential\": True, \"Continuous\": True,  \"Sequential_MALA\": True,\n",
    "                     \"Global_MALA_moves\": True, \"N_Global_MALA_sweeps\": 10},\n",
    "      \"Run_2.3.3\"  : {\"desc\": \"Langevin dynamics update\",\n",
    "                      \"Sequential\": False, \"Langevin\": True, \"Continuous\": True, \"Delta_t_Langevin_HMC\": 0.1, \"Max_Force\":5.0},\n",
    "      \"Run_2.3.4\"  : {\"desc\": \"HMC update\",\n",
    "                      \"Sequential\": False, \"HMC\": True, \"Continuous\": True, \"Delta_t_Langevin_HMC\": 0.5, \"Leapfrog_steps\":100, \"NSweep\": 50,},\n",
    "}\n",
    "\n",
    "descriptions = {}\n",
    "sims = {}\n",
    "for sim_dir, overrides in variants.items():\n",
    "    overrides = overrides.copy()\n",
    "    descriptions[sim_dir] = overrides.pop(\"desc\", \"\")\n",
    "    params = {**base_params, **overrides}\n",
    "    sims[sim_dir] = Simulation(\n",
    "        alf_src,\n",
    "        \"Hubbard\",\n",
    "        params,\n",
    "        machine='GNU',   # Change to \"intel\", or \"PGI\" if gfortran is not installed\n",
    "        mpi=True,\n",
    "        devel=False,\n",
    "        sim_dir=sim_dir,\n",
    "    )"
   ]
  },
