    "for sim_dir, sim in sims.items():\n",
    "    sim.run()\n",
    "    sim.analysis()\n",
    "    obs = sim.get_obs()\n",
    "    # dots in sim_dir are not valid in identifiers, so sanitize for the variable name\n",
    "    var_name = f\"Energy_{sim_dir.replace('.', '_')}\"\n",
    "    globals()[var_name] = obs.iloc[0][['Ener_scal0', 'Ener_scal0_err', 'Ener_scal_sign', 'Ener_scal_sign_err']]"
   ]
